{
  "expo": {
    "name": "redback.ai",
    "slug": "redback-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/design/redback-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/design/redback-logo-white.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#E84B3C",
          "dark": {
            "backgroundColor": "#E84B3C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
