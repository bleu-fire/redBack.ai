{
  "expo": {
    "name": "redback.ai",
    "slug": "redback-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/design/redback-logo.png",
    "scheme": "redback",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.redbackai"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Sentient-Regular.ttf",
            "./assets/fonts/Sentient-Italic.ttf",
            "./assets/fonts/Sentient-Medium.ttf",
            "./assets/fonts/Sentient-MediumItalic.ttf",
            "./assets/fonts/Sentient-Bold.ttf",
            "./assets/fonts/Sentient-BoldItalic.ttf",
            "./assets/fonts/Sentient-Light.ttf",
            "./assets/fonts/Sentient-LightItalic.ttf",
            "./assets/fonts/Sentient-Extralight.ttf",
            "./assets/fonts/Sentient-ExtralightItalic.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow redBack.ai to access your camera to scan and identify spiders."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
