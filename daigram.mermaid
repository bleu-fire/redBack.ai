classDiagram

%% ==========================
%% MODELS
%% ==========================

class User {
    +ObjectId _id
    +String fullname
    +String email
    +String passwordHash
    +String avatarUrl
    +Date createdAt
    +Date updatedAt
}

class Species {
    +ObjectId _id
    +String scientificName
    +String commonName
    +String family
    +String genus
    +String description
    +String habitat
    +String distribution
    +String behavior
    +String venomInfo
    +String conservationStatus
    +String[] imageUrls
    +Date createdAt
    +Date updatedAt
}

class Identification {
    +ObjectId _id
    +ObjectId userId
    +String imageUrl
    +String status
    +Date createdAt
    +Date updatedAt
}

class Prediction {
    +ObjectId speciesId
    +String scientificName
    +String commonName
    +Number confidence
    +String confidenceBand
}

class LearningTopic {
    +ObjectId _id
    +String slug
    +String title
    +String content
    +String category
    +String sourceUrl
    +Date createdAt
    +Date updatedAt
}

%% Relationships
User "1" --> "*" Identification : creates
Identification "1" *-- "*" Prediction : contains
Prediction "*" --> "1" Species : references

%% ==========================
%% CONTROLLERS / SERVICES
%% ==========================

class AuthController {
    +register(fullname, email, password, avatarUrl)
    +login(email, password)
    +getMe()
    +getStatus()
}

class SpeciesController {
    +createSpecies(data)
    +getAllSpecies(searchQuery)
    +searchSpecies(q, page, limit)
    +getSpeciesById(id)
    +updateSpecies(id, data)
    +deleteSpecies(id)
}

class IdentificationsController {
    +createIdentification(imageUrl)
    +getAllIdentifications()
    +getIdentificationById(id)
}

class LearningController {
    +getAllTopics(category)
    +getTopicBySlug(slug)
    +createTopic(slug, title, content)
}

%% Controller to Model Dependencies
AuthController --> User
SpeciesController --> Species
IdentificationsController --> Identification
LearningController --> LearningTopic