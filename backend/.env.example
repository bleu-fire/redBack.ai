PORT=3000
NODE_ENV=development

# Database (MongoDB / Mongoose)
MONGO_URI=mongodb://localhost:27017/redback_db

# JWT Auth
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Chat providers
DEEPSEEK_API_KEY=

# Optional model overrides
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# DEEPSEEK_MODEL=deepseek-chat

# Pinecone vector search
PINECONE_API_KEY=
PINECONE_INDEX=redback-spider-vision
PINECONE_HOST=
INAT_PINECONE_NAMESPACE=inaturalist-spiders
INAT_SPIDER_IMAGE_COUNT=2000
